.DS_Store
**/.DS_Store
node_modules/
build/

# Clean-room (Phase 3 red line #5): proprietary telemetry / vendor binary data NEVER enters the repo.
# Real .bmsbin and vendor formats are only ever read locally; tests use synthetic fixtures only.
*.bmsbin
*.pds
*.cvp
*.pvp
*.mch
*.tir
*.fnl

# Local-only work artifact (translation cache)
.i18n-cache/

# Local editor / agent config — never publish
.claude/

# Backup / temp / patch artifacts — never publish
*.bak
*.backup
*.orig
*.rej
*~

# Prevent accidental commit of private telemetry exports (real CSV stays local; tests use
# inline synthetic fixtures). If a synthetic fixture ever needs committing, whitelist it
# explicitly, e.g.:  !tests/fixtures/*.csv
*.csv

# This project has never tracked an npm lockfile; exclude to avoid an accidental commit
# (revisit if a lockfile policy is later adopted).
package-lock.json
